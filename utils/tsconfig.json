{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "declaration": true,
    "declarationMap": false,
    "outDir": "../dist/utils",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "index.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
