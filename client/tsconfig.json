{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "allowJs": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "../dist/client"
  },
  "include": [
    "src/**/*",
    "index.ts",
    "wysiwyg.ts",
    "wysiwyg/**/*",
    "src/data/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "references": [
    {
      "path": "../utils"
    }
  ]
}
