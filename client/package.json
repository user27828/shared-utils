{
  "name": "@shared-utils/client",
  "version": "0.69.3",
  "description": "React components and client-side utilities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wysiwyg": {
      "types": "./dist/wysiwyg.d.ts",
      "import": "./dist/wysiwyg.js",
      "default": "./dist/wysiwyg.js"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && yarn tsc --build",
    "build:clean": "rm -f tsconfig.tsbuildinfo && rm -rf ../dist/client && yarn build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "yarn tsc --outDir ../dist/client --watch"
  },
  "peerDependencies": {
    "@ckeditor/ckeditor5-react": ">=9.0.0",
    "@mdxeditor/editor": ">=3.0.0 <5.0.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/lab": "^9.0.0-beta.3",
    "@mui/material": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.0",
    "@tinymce/tinymce-react": ">=5.0.0",
    "ckeditor5": ">=44.0.0",
    "easymde": ">=2.0.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "tinymce": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@ckeditor/ckeditor5-react": {
      "optional": true
    },
    "@mdxeditor/editor": {
      "optional": true
    },
    "@mui/lab": {
      "optional": true
    },
    "@mui/x-date-pickers": {
      "optional": true
    },
    "@tinymce/tinymce-react": {
      "optional": true
    },
    "ckeditor5": {
      "optional": true
    },
    "easymde": {
      "optional": true
    },
    "tinymce": {
      "optional": true
    }
  },
  "dependencies": {
    "@shared-utils/utils": "workspace:*",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.14",
    "papaparse": "^5.6.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/lab": "^9.0.0-beta.8",
    "@mui/material": "^9.3.1",
    "@mui/system": "^9.3.0",
    "@mui/x-date-pickers": "^9.11.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
