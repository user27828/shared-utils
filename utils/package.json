{
  "name": "@shared-utils/utils",
  "version": "0.69.2",
  "description": "Core utilities (log, turnstile, options-manager)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "node ../scripts/clean-dist.mjs utils && yarn tsc --outDir ../dist/utils",
    "build:clean": "yarn build",
    "test": "yarn build && NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:watch": "yarn build && NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "dev": "yarn tsc --outDir ../dist/utils --watch"
  },
  "dependencies": {
    "lodash-es": "^4.18.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.3",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
