{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "agent-config-repo-sync",
      "type": "process",
      "command": "node",
      "args": [
        "${env:HOME}/.local/share/agent-config/bin/agent-config.mjs",
        "repo-sync",
        "--root",
        "${workspaceFolder}",
        "--apply"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true
      }
    }
  ]
}
